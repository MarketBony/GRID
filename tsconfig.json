{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "*.ts",
    "*.tsx",
    "pages/**/*",
    "components/**/*",
    "contexts/**/*",
    "hooks/**/*",
    "services/**/*",
    "lib/**/*",
    "utils/**/*",
    "backend/src/utils/agregats.ts",
    "backend/src/utils/suivi.ts",
    "backend/src/utils/repartition.ts",
    "backend/src/utils/tri.ts",
    "backend/src/utils/importMarques.ts",
    "backend/src/utils/presenceVendeur.ts",
    "backend/src/auth/roles.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "backend/node_modules",
    "backend/dist"
  ]
}
