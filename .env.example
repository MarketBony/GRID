# ============================================================================
# Variables du FRONT (prefixe VITE_, inlinees dans le bundle : rien de secret)
# ============================================================================
# Vide en developpement ET en production : le front appelle /api en relatif.
# Vite proxifie vers le port 3001 en dev, Caddy sert le front et l'API sous le
# meme domaine en prod. Une URL absolue ici casserait aussi socket.io.
VITE_API_URL=

# ============================================================================
# Variables du BACKEND — copier dans backend/.env pour le developpement local
# ============================================================================
# Secret de signature des JWT. Generer : openssl rand -hex 32
JWT_SECRET=change-me

# --- DEVELOPPEMENT LOCAL ---------------------------------------------------
# Postgres local. `?schema=relance` : le schema garde son nom malgre le
# renommage du produit en GRID — voir CLAUDE.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relance?schema=relance
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/relance?schema=relance

# ============================================================================
# PRODUCTION — fichier `.env` a la racine du projet SUR LE VPS, hors git.
#
# Supabase a ete ECARTE le 31/08/2026 : Postgres tourne sur le VPS, dans le
# conteneur `grid-db-1`. Il n'y a donc plus deux chaines de connexion (pooler
# transaction + pooler session) mais une seule, et docker-compose.yml la
# construit lui-meme a partir de POSTGRES_PASSWORD.
#
# Ne mettre dans ce .env QUE les quatre lignes ci-dessous.
# ============================================================================
# Domaine public. Doit exister en DNS et pointer sur le VPS AVANT le premier
# demarrage : Caddy demande le certificat des la premiere requete, et
# Let's Encrypt limite les tentatives echouees.
# DOMAIN=grid.bonyauto-mobile.com

# Mot de passe du role Postgres `grid`. Generer : openssl rand -base64 24
# Il n'a pas a etre memorise : rien ne s'y connecte a la main, la base ne publie
# aucun port et seul grid-api l'atteint.
# POSTGRES_PASSWORD=

# Secret JWT de PRODUCTION, different de celui de developpement.
# Le changer deconnecte tout le monde — c'est le seul moyen de revoquer en bloc.
# JWT_SECRET=

# Retention des sauvegardes, en jours. Voir scripts/sauvegarde.sh.
# RETENTION_JOURS=30
