# ============================================================================
# Variables du FRONT (prefixe VITE_, inlinees dans le bundle : rien de secret)
# ============================================================================
# Vide en developpement : le front appelle /api en relatif, Vite proxifie vers
# le backend sur le port 3001 (voir vite.config.ts).
VITE_API_URL=

# ============================================================================
# Variables du BACKEND — copier dans backend/.env
# ============================================================================
# Secret de signature des JWT. Generer : openssl rand -hex 32
JWT_SECRET=change-me

# --- DEVELOPPEMENT LOCAL ---------------------------------------------------
# Postgres local. Le schema `relance` est cible par ?schema=relance : c'est ce
# qui rend la decision d'hebergement (projet Supabase dedie ou schema dans un
# projet existant) sans impact sur le code — seule cette ligne change.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relance?schema=relance
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/relance?schema=relance

# --- PRODUCTION (Supabase, region eu-west-3 / Paris) ----------------------
# Connexion applicative : pooler TRANSACTION (6543). ?pgbouncer=true est exige
# par Prisma, qui desactive alors les prepared statements.
# DATABASE_URL=postgresql://USER:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=relance
# Migrations (prisma migrate deploy) : pooler SESSION (5432), sans pgbouncer.
# Le mode transaction ne supporte pas les migrations.
# DIRECT_URL=postgresql://USER:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?schema=relance

# ============================================================================
# Variables consommees par docker-compose.yml (deploiement VPS)
# ============================================================================
# Domaine public. Le certificat Let's Encrypt est emis par le Caddy de gearbox,
# qui importe relance.caddy — voir DEPLOIEMENT.md.
DOMAIN=relance.bonyauto-mobile.com
PORT=3000
