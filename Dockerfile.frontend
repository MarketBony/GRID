# ============================================================================
# Front GRID — bundle Vite servi par nginx. Même forme que gearbox.
#
# Le contexte de build est la RACINE du dépôt, qui contient aussi `backend/`.
# `.dockerignore` l'écarte, avec les node_modules et le dist local : sans lui,
# le contexte envoyé au démon fait des centaines de mégaoctets et le build
# recompile à chaque fois.
# ============================================================================

FROM node:22-alpine AS build
WORKDIR /app

# Les manifestes d'abord : cette couche n'est réinvalidée que si les
# dépendances changent, pas à chaque édition d'un composant.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# VITE_API_URL reste VIDE en production, et c'est voulu : le front n'appelle que
# des URL relatives (`/api/...`), Caddy sert le front et l'API sous le même
# domaine. Une URL absolue ici casserait aussi les WebSockets de socket.io.
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
