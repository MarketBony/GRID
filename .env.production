# ============================================================================
# CONFIGURATION DE PRODUCTION — VERSIONNEE, ET C'EST DELIBERE.
#
# Ces deux valeurs NE SONT PAS DES SECRETS. Vite les fige dans le bundle a la
# compilation : elles sont lisibles par quiconque ouvre les outils de
# developpement sur le site en ligne. Les cacher dans un tableau de bord
# n'apporterait donc RIEN en securite — c'est la RLS qui protege, verifiee dans
# les deux sens par `test:rls`.
#
# En revanche, les y cacher ajoute une facon de casser le deploiement : les
# variables `VITE_*` doivent etre presentes AU MOMENT DU BUILD, et une variable
# declaree pour l'EXECUTION cote hebergeur n'est jamais lue par un fichier deja
# compile. C'est exactement ce qui a produit une page blanche au premier
# deploiement Cloudflare.
#
# Ce fichier rend le build reproductible partout — Cloudflare, une autre machine,
# un autre hebergeur — sans aucun reglage a refaire.
#
# CE QUI N'A RIEN A FAIRE ICI : la cle `service_role` et le mot de passe de la
# base. Ils vivent dans `backend/.env.supabase`, ignore par git, et ne doivent
# jamais porter le prefixe `VITE_` — qui les enverrait dans le bundle.
# ============================================================================

VITE_SUPABASE_URL="https://ganeczlhcprljuazldpp.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_ZeU0BcfdA2EljkwJTG6Rvg_x1NBFz76"
