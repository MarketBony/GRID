# =============================================================================
# CONNEXION A SUPABASE — modele. Copier en `.env.supabase` et remplir.
#
# `.env.supabase` est ignore par git (regle `.env.*` du .gitignore) : le mot de
# passe de la base n'entre donc jamais dans le depot. Il ne doit pas non plus
# etre passe en argument de ligne de commande — les arguments d'un processus sont
# lisibles par les autres processus de la machine et restent dans l'historique du
# terminal. On charge ce fichier dans l'environnement, et on ne l'affiche pas :
#
#   set -a; . backend/.env.supabase; set +a
#   npm --prefix backend run migrate:deploy
#
# OU TROUVER LE MOT DE PASSE : tableau de bord Supabase, Settings > Database.
# Il n'est montre qu'a la creation du projet ; s'il a ete perdu, le bouton
# « Reset database password » en genere un nouveau.
#
# -----------------------------------------------------------------------------
# LES DEUX CHAINES, ET POURQUOI ELLES DIFFERENT
# -----------------------------------------------------------------------------
# `DATABASE_URL`  — ce que l'application utiliserait au quotidien. Le pooler en
#                   mode TRANSACTION (port 6543) recycle les connexions entre les
#                   requetes, ce qui est le bon mode pour un service qui en ouvre
#                   beaucoup et brievement.
#
# `DIRECT_URL`    — ce que Prisma utilise pour les MIGRATIONS. Le mode transaction
#                   ne les supporte pas : une migration ouvre une transaction
#                   longue, pose des verrous et emet du DDL, ce que le pooler
#                   transactionnel ne sait pas porter. D'ou le mode SESSION
#                   (port 5432), ou la connexion est a nous pour toute sa duree.
#
#                   S'y tromper ne donne pas une erreur claire : la migration part
#                   puis se bloque ou echoue au milieu, ce qui est le pire moment.
#
# `?schema=relance` sur les deux : c'est le schema du produit. Sans lui, Prisma
# ecrit dans `public`, ou vivent deja les objets de Supabase.
# =============================================================================

DATABASE_URL="postgresql://postgres.ganeczlhcprljuazldpp:MOT_DE_PASSE@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?schema=relance&pgbouncer=true"
DIRECT_URL="postgresql://postgres.ganeczlhcprljuazldpp:MOT_DE_PASSE@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?schema=relance"

# Cle publique, celle qui part dans le bundle du navigateur. Aucun secret ici :
# c'est la RLS qui protege, pas la discretion de cette valeur.
VITE_SUPABASE_URL="https://ganeczlhcprljuazldpp.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_ZeU0BcfdA2EljkwJTG6Rvg_x1NBFz76"

# La cle `service_role`. Elle contourne TOUTE la RLS : elle ne doit JAMAIS se
# trouver dans le navigateur, ni dans une variable prefixee `VITE_` (qui partirait
# dans le bundle). Seuls `comptes-auth` et l'Edge Function la lisent.
SUPABASE_SECRET_KEY="a_remplir"
